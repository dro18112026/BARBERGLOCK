# Copy to .env.local (local dev) and set the same vars in your host's dashboard.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in cancellation links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Barbershop phone, international format without "+" (e.g. 56912345678)
NEXT_PUBLIC_BUSINESS_PHONE=

# Optional — confirmation emails (Phase 7)
RESEND_API_KEY=
