# Copy to .env.local (local dev) and set the same vars in your host's dashboard.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in cancellation links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Barbershop phone, international format without "+" (e.g. 56912345678)
NEXT_PUBLIC_BUSINESS_PHONE=

# Optional — confirmation emails (Phase 7)
RESEND_API_KEY=

# Push notifications to the panel (Mi cuenta → Avisos en el celular).
# Generate the keys once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only.
VAPID_PRIVATE_KEY=
# Contact for the push services: the site URL or mailto:you@example.com
VAPID_SUBJECT=
# Shared secret for the 30-minute reminders (database → /api/push/reminders).
# Any long random string; the same value goes in Supabase Vault (see README).
PUSH_CRON_SECRET=
